# ==============================================================================
# BAYORA Environment Configuration Template
# Do NOT commit real API keys or secrets to version control.
# ==============================================================================

# Application Environment ('development', 'test', 'production')
APP_ENV=development

# Explicit Mock Mode Control
# When false, real model inference is strictly required and mock models are disabled.
MOCK_MODE_ENABLED=true

# Role Minting Controls
# In production, set to false so callers cannot self-mint privileged roles via /api/auth/token.
ALLOW_DEMO_TOKEN_ROLE_SELECTION=true
# OPERATOR_MASTER_SECRET=your-production-operator-master-secret-here

# Default Provider & Model ('mock', 'openai', 'gemini')
DEFAULT_PROVIDER=mock
DEFAULT_MODEL_PROFILE=mock-deterministic-v1

# ------------------------------------------------------------------------------
# OpenAI / Compatible Provider (OpenAI, Ollama, vLLM, LMStudio)
# ------------------------------------------------------------------------------
# For real OpenAI, set your API key:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o,gpt-4o-mini,o3-mini

# For local Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODELS=llama3.2,mistral
# ALLOW_PRIVATE_ENDPOINTS=true

# ------------------------------------------------------------------------------
# Google Gemini Provider
# ------------------------------------------------------------------------------
# For real Gemini, set your API key:
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro

# ------------------------------------------------------------------------------
# SSRF & Self-Hosted Endpoint Restrictions
# ------------------------------------------------------------------------------
# Set to true only in development/self-hosted environments to permit RFC1918 / localhost endpoints.
ALLOW_PRIVATE_ENDPOINTS=false
ALLOWED_CUSTOM_HOSTS=

# ------------------------------------------------------------------------------
# Resilience, Timeouts & Concurrency Limits
# ------------------------------------------------------------------------------
INFERENCE_CONNECT_TIMEOUT_SEC=10.0
INFERENCE_READ_TIMEOUT_SEC=45.0
INFERENCE_MAX_RETRIES=2
INFERENCE_MAX_CONCURRENCY=5
MAX_PROMPT_CHARS=12000
MAX_OUTPUT_TOKENS=2048

# ------------------------------------------------------------------------------
# Database & Control Plane
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./bayora.db
AUTH_SECRET_KEY=bayora_sec_hmac_key_prod_2026_isolated
TOKEN_EXPIRY_SECONDS=86400
